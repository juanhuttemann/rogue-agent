# OpenAI-compatible model server. Keep its port distinct from OpenSandbox.
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=no-key
OPENAI_MODEL=your-model-name
# OPENAI_MAX_TOKENS=8192

# Match these values to the [server] section of ~/.sandbox.toml.
OPENSANDBOX_API_KEY=your-sandbox-api-key
OPENSANDBOX_DOMAIN=localhost:8080
OPENSANDBOX_PROTOCOL=http
